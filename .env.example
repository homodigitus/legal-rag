# =========================================================
# Eksun Legal RAG - Ortam Degiskenleri (ornek dosya)
# Kopyala: cp .env.example .env
# .env dosyasi git'e COMMIT EDILMEZ (.gitignore icinde).
# =========================================================

# ---- Genel ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- Yerel LLM (Ollama) ----
# Ollama'nin local calistigi adres. Docker icindeyken host.docker.internal kullanilir.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
# Alternatifler: mistral:7b, qwen2.5:7b-instruct, llama3.2:3b (daha hizli, dusuk kaynak)

# HuggingFace API token (opsiyonel, embedding model indirme ve cache icin)
HF_API_TOKEN=

# ---- Embedding Modeli ----
# HuggingFace sentence-transformers, tamamen local calisir (indirilip cache'lenir)
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
EMBEDDING_DEVICE=cpu

# ---- Vektor Veritabani (Chroma) ----
CHROMA_PERSIST_DIR=./db/chroma_store
CHROMA_COLLECTION_NAME=cuad_contracts

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# ---- Retrieval ----
RETRIEVAL_TOP_K=4

# ---- Veri ----
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
CUAD_JSON_PATH=./data/raw/CUAD_v1.json

# ---- Streamlit ----
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ---- (Opsiyonel) Bulut LLM fallback - EPDK/on-prem kisitlari nedeniyle KULLANILMASI ONERILMEZ ----
# OPENAI_API_KEY=
